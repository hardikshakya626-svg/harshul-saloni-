rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all to prevent unintended access
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidRsvp(data) {
      return data.keys().hasAll(['name', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 200
        && (!('guestCount' in data) || (data.guestCount is string && data.guestCount.size() <= 20) || (data.guestCount is number))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && (!('events' in data) || (data.events is list) || (data.events is string))
        && (!('wishes' in data) || (data.wishes is string && data.wishes.size() <= 2000))
        && data.createdAt is string
        && data.createdAt.size() <= 60;
    }

    function isValidHeroPhoto(data, frameId) {
      return data.keys().hasAll(['frameId', 'imageUrl', 'updatedAt'])
        && data.keys().hasOnly(['frameId', 'imageUrl', 'updatedAt'])
        && data.frameId == frameId
        && (data.frameId in ['frame1', 'frame2', 'frame3', 'filmHero'] || (data.frameId is string && data.frameId.size() >= 1 && data.frameId.size() <= 40 && data.frameId.matches('^[a-zA-Z0-9_\\-]+$')))
        && data.imageUrl is string
        && data.imageUrl.size() <= 950000
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    // Connection verification endpoint
    match /test/{testId} {
      allow get: if isValidId(testId);
    }

    // Wedding RSVP collection
    match /rsvps {
      allow read, get, list: if true;
    }
    match /rsvps/{rsvpId} {
      // Allow reading and listing RSVPs for guest portal
      allow read, get, list: if true;
      // Allow guests to submit their RSVP
      allow create: if isValidId(rsvpId) && isValidRsvp(incoming());
      // Allow admin portal to update or delete RSVPs
      allow update, delete: if isValidId(rsvpId);
    }

    // Editorial hero photos persistent for client preview
    match /hero_photos/{frameId} {
      allow get, list: if isValidId(frameId);
      allow create, update: if isValidId(frameId) && isValidHeroPhoto(incoming(), frameId);
      allow delete: if isValidId(frameId);
    }
  }
}
